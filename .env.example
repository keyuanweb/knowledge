# 复制为 .env 后供 docker compose 使用；本地开发也可参考设置同名环境变量

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DB=db_enterprise_qa
MYSQL_PUBLISH_PORT=3306
API_PUBLISH_PORT=5000

# 生产务必改为长随机串（建议 32+ 字符）
JWT_SECRET=change-me-to-a-long-random-string

# 浏览器访问前端的来源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 宿主机 Ollama（Windows/Mac Docker 可用 host.docker.internal；Linux 可用宿主机 IP）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# 可选：设置后 GET /api/metrics 需带 Authorization: Bearer <token>
METRICS_TOKEN=

# 前端（Vite）可选品牌化
# VITE_APP_TITLE=企业知识库
# VITE_APP_SUBTITLE=RAG · Ollama · Chroma
# VITE_API_BASE_URL=http://localhost:5000/api

# RAG 可调参数（可选）
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# RAG_MAX_DISTANCE=
# MAX_QUESTION_LENGTH=8000
# MAX_UPLOAD_BYTES=52428800
